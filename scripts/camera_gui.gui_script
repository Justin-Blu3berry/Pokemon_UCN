	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	-- Add message-handling code here
	print("camera GUI received a message: " .. message_id .. " from sender:" .. sender)

	-- check if the message says to show the GUI
	if message_id == hash("show") then

		-- post messages to the system to enable this object
		-- and to acquire input focus
		msg.post(".", "enable")
		msg.post(".", "acquire_input_focus")
		print("camera gui enabled and acquired input focus")

		-- check if the message says to hide the GUI
	elseif message_id == hash("hide") then

		-- post messages to the system to disable this object
		-- and release input focus
		msg.post(".", "disable")
		msg.post(".", "release_input_focus")
		print("camera gui disabled and released input focus")

	elseif message_id == hash("new_night") then

		-- call the function that resets this game object and all its
		-- variables for the start of a new night
		start_night(self)

	elseif message_id == hash("update_debug") then

		-- check whether the radar debug option is on
		self.is_radar = contains(message.debug_options, "radar")

		print("Radar debug option is: " .. tostring(self.is_radar))
		print(self.char_list[1])

		-- enable or disable the gui nodes with the character icons indicating their positions
		for __, curr_char in ipairs(self.char_list) do
			-- set the current character's icon to be visible or not
			print(curr_char)
			gui.set_enabled(gui.get_node(curr_char .. "_icon"), self.is_radar)
		end

	elseif message_id == hash("move_character") then

		-- this message moves the position of the named character's icon on the minimap
		-- but the way we have to access the positions dictionary is different depending on if
		-- the character is in the office
		if message.new_pos == "office" then
			-- if the character has moved to the doors of the office, move them to the appropriate
			-- position on the minimap to reflect that
			pprint(message)
			gui.set_position(gui.get_node(message.char_name .. "_icon"), self.radar_positions[message.char_name][message.new_pos][message.side])
			
		else
			-- since the character is just at a normal camera, just put them in their spot in that room
			gui.set_position(gui.get_node(message.char_name .. "_icon"),self.radar_positions[message.char_name][message.new_pos])
		end

	end

end


local function get_clicked_cam(self, mouse_x, mouse_y)
	-- function that iterates over all camera nodes' names to idenitfy which 
	-- of the camera buttons got clicked

	-- iterate over a list of the camera button node names
	-- yes, this is the lua version of "for item in list:"
	for __, curr_node in ipairs(self.camera_buttons_list) do

		-- check if the current one is being selected with get_node()
		if gui.pick_node(gui.get_node(curr_node), mouse_x, mouse_y) then
			
			-- return the name of the node that's at the mouse's x and y coords
			return curr_node
			
		end
	end

	-- this only runs if no node was clicked, return that no node was clicked 
	-- (this avoids returning a nil value)
	return "none"
end


local function try_change_cameras(self, action_id, action)
	print("mouse 1 clicked while in cameras!")
	-- identify the camera button node that was clicked
	local clicked_node = get_clicked_cam(self, action.x, action.y)
	print("Clicked node is " .. clicked_node)

	-- only proceed with string processing and updating the camera if a camera button
	-- node was actually clicked, i.e. the clicked node isn't "No camera clicked"
	if clicked_node ~= "none" then

		-- get the number of the clicked camera button by slicing the number from the string
		-- since all camera nodes' strings are formatted as "Cam XX Button" so the number is
		-- always on indices 4 and 5
		local clicked_camera = string.sub(clicked_node, 0, 6)
		print("Clicked camera is " .. clicked_camera)

		-- make the previous camera's button grey out
		gui.play_flipbook(gui.get_node(self.camera_location .. " Button"), self.camera_location .. " Button")

		-- update the camera location
		self.camera_location = clicked_camera
		msg.post("/camera/camera", "change to " .. clicked_camera)

		-- change the new camera's button to be highlighted
		gui.play_flipbook(gui.get_node(self.camera_location .. " Button"), self.camera_location .. " Button Selected")

		-- change the text indicating the room name
		local location_name = self.camera_names[self.camera_location]
		gui.play_flipbook(gui.get_node("camera location"), location_name .. " text")
		
		-- move the text indicating the room name so it's aligned correctly
		move_room_text(self)

		-- make the generator's rapid spin button visible or not depending on if cam 8 is selected
		gui.set_enabled(gui.get_node("rapid_spin_button"), self.camera_location == "Cam 08")
		
		-- send a message to the camera background object to change its sprite to the new location
		msg.post("/camera/camera", "change_camera_location", { new_cam = self.camera_location })

		-- send a message to all characters indicating the new camera location
		message_characters("change_camera_location", { new_cam = self.camera_location })
		-- print("player is now looking at: " .. self.camera_location)

		-- send a message to all props indicating the new camera location
		message_props("change_camera_location", { new_cam = self.camera_location })
		
	end
end


local function try_rapid_spin(mouse_x, mouse_y)
	-- function to recognize if the rapid spin button has been clicked and spin the generator
	-- if it has been

	-- check if the spin button has been clicked	
	if gui.pick_node(gui.get_node("rapid_spin_button"), mouse_x, mouse_y) then

		-- since the player has clicked the rapid spin button, animate the button
		gui.play_flipbook(gui.get_node("rapid_spin_button"), "rapid spin button selected", function()
			-- when the animation is done, reset to the original sprite
			gui.play_flipbook(gui.get_node("rapid_spin_button"), "rapid spin button")
		end)

		-- tell the office GUI to remove the seeded effect from the generator
		msg.post("/office_GUI", "spin_generator")

		-- also tell the generator prop to run its animation
		-- TODO: make a second animation for the generator when it isn't seeded
		msg.post("/camera/generator", "animate_prop", { animation_name = "generator_spinning", return_when_done = true } )

	end
end


function on_input(self, action_id, action)
	-- Add input-handling code here. The game object this script is attached to
	-- check if mouse 1 has been clicked
	
	if action_id == hash("mouse1")  and action.released then
		-- check if a camera button's node was clicked, and update cameras if yes
		try_change_cameras(self, action_id, action)

		-- check if the rapid spin button was clicked, and spin the generator if yes
		try_rapid_spin(action.x, action.y)
		
	end
	
end