-- import the module with the dictionary mapping camera numbers to location names
local cams = require "scripts.camera_mapping"
-- import the module that lets us generate lists and dicts that use character names
local characters = require "scripts.character_lists"
local props = require "scripts.prop_lists"


local function contains(iterable, element)
	-- function to determine if element is present in the passed iterable
	-- it does this by iterating through the iterable with a for loop and breaking 
	-- to return true if any element in the iterable is equal to the param 'element'
	-- @param iterable: table, gets iterated through to find a given element
	-- @param element: the str, int, float, bool, table getting searched for
	-- @return: true if element is present in the iterable, false if it can't be found

	-- iterate through the elements of the iterable
	for __, item in ipairs(iterable) do
		-- check if the current item is the specified element
		if item == element then
			-- since the specified element was found, return true
			return true
			
		end
	end

	-- the only way we make it out of the for loop is if the specified element can't be found
	return false
	
end


local function message_characters(message_id, message)
	-- function to send a message with the given ID and table to all characters in the cast
	-- @param message_id: str, the message ID  to be hashed
	-- @param message: OPTIONAL table, the values that are being passed in the message
	-- @return: none, just posts like 20 messages lmao

	-- iterate through all the characters in the cast
	for curr_character, curr_url in pairs(characters.get_character_urls()) do
		msg.post(curr_url, message_id, message)
	end
end


local function message_props(message_id, message)
	-- function to send a message with the given ID and table to all props in the camera
	-- @param message_id: str, the message ID  to be hashed
	-- @param message: OPTIONAL table, the values that are being passed in the message
	-- @return: none, just posts like 20 messages lmao

	-- iterate through all the characters in the cast
	for curr_prop, curr_url in pairs(props.get_prop_urls()) do
		msg.post(curr_url, message_id, message)
	end
end


local function get_camera_nodes_table()
	-- function to automatically generate a list of all the camera button nodes

	-- initialize the list to return
	local nodes_list = {}

	-- iterate over the number of cameras (11)
	for i = 1, 11 do

		-- check if the current number is single-digit
		if i < 10 then
			-- format as "Cam 01 Button" instead of "Cam 1 Button"
			table.insert(nodes_list, string.format("Cam 0%d Button", i))

		else
			-- for double digit camera numbers, format as "Cam 10 Button" instead of "Cam 010 Button"
			table.insert(nodes_list, string.format("Cam %d Button", i))

		end
	end

	-- now that the list is generated, return it
	return nodes_list
end


function init(self)
	-- function that runs on app startup

	-- get a list of the camera button node names
	self.camera_buttons_list = get_camera_nodes_table()

	-- import the dictionary mapping the camera numbers to the locations' names
	self.camera_names = cams.get_camera_dict()
	
	-- initialize a variable tracking if the radar debug option is active
	self.is_radar = false

	-- define a dicitonary mapping camera numbers to the coordinates the text needs
	-- to be at to be aligned properly on the HUD
	self.left_aligned = {
		["Cam 01"] = 1057,
		["Cam 02"] = 1072,
		["Cam 03"] = 1052,
		["Cam 04"] = 1007,
		["Cam 05"] = 1007,
		["Cam 06"] = 1077,
		["Cam 07"] = 1079,
		["Cam 08"] = 1057,
		["Cam 09"] = 1002,
		["Cam 10"] = 1003,
		["Cam 11"] = 1025
	}

	self.center_aligned = {
		["Cam 01"] = 1057,
		["Cam 02"] = 1057,
		["Cam 03"] = 1057,
		["Cam 04"] = 1057,
		["Cam 05"] = 1057,
		["Cam 06"] = 1057,
		["Cam 07"] = 1057,
		["Cam 08"] = 1057,
		["Cam 09"] = 1057,
		["Cam 10"] = 1057,
		["Cam 11"] = 1025
	}

	self.right_aligned = {
		["Cam 01"] = 1057,
		["Cam 02"] = 1043,
		["Cam 03"] = 1065,
		["Cam 04"] = 1109,
		["Cam 05"] = 1108,
		["Cam 06"] = 1042,
		["Cam 07"] = 1039,
		["Cam 08"] = 1059,
		["Cam 09"] = 1113,
		["Cam 10"] = 1116,
		["Cam 11"] = 987
	}


	-- define the list of character names
	self.char_list = characters.get_character_list()

	-- define the 2d table mapping character + camera location combos to xy coords to place their icons at
	self.radar_positions = characters.get_radar_positions(vmath)

	-- make the rapid spin button invisible
	gui.set_enabled(gui.get_node("rapid_spin_button"), false)

	print("camera_GUI.gui_script init function ran")

end


local function move_room_text(self)
	-- function to set the position of the text indicating the room name
	-- based on which camera the player is looking at
	-- this is to ensure that the text is in the right position
	-- @param self: 
	-- @return: none

	-- calculate the new position for the text (only the x coordinate needs to change)
	local text_position = vmath.vector3(self.right_aligned[self.camera_location], 305, 0)

	-- set the text to the right position
	gui.set_position(gui.get_node("camera location"), text_position)

end


local function start_night(self)
	-- function to reset this game object for the start of a night
	
	-- initialize (or reset) the camera location to camera 1
	self.camera_location = "Cam 01"

	-- reset the position of the text indicating what room the player is looking at
	move_room_text(self)

	-- reset the camera 1 button to have its button be highlighted
	gui.play_flipbook(gui.get_node("Cam 01 Button"), "Cam 01 Button Selected")

	-- reset the camera location's text to make sure it is set to the text for camera 1
	gui.play_flipbook(gui.get_node("camera location"), "show stage text")

	-- reset the camera's background sprite to be the background for camera 1
	msg.post("/camera/camera", "change_camera_location", { new_cam = self.camera_location })

	-- make the rapid spin button invisible
	gui.set_enabled(gui.get_node("rapid_spin_button"), false)

	-- get a list of all camera button node names
	local cameras = get_camera_nodes_table()

	-- iterate over all of the other cameras (2-11) and make sure they correctly
	-- display that they're not selected at start of night
	for index = 1, #cameras do
		
		-- skip the first index, since we don't want to display cam 01 as being
		-- deselected
		if index ~= 1 then
			
			-- set the current camera button node to display its greyed out sprite
			gui.play_flipbook(gui.get_node(cameras[index]), cameras[index])

		end
	end
end


